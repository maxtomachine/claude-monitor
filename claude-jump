#!/usr/bin/env bash
# claude-jump <sid8|full-sid|session-name>
#
# Raise the Ghostty window/tab hosting the given Claude session.
#
# Two paths:
#   1. If claude-monitor is running, drop the target into a request file —
#      the monitor watches for it and performs the jump with its own
#      (already TCC-authorized) JXA. This is the path used by the ClaudeJump
#      macOS Shortcut: the Shortcuts sandbox cannot send Apple Events to
#      Ghostty (windows() returns empty, no prompt is offered), so the jump
#      must be delegated to a process in the user's login session.
#   2. Otherwise, do the JXA directly (works from any normal shell).
#
# Exit codes: 0 = jumped/delegated, 1 = not found, 2 = no argument

printf '%s argc=%d argv=%s\n' "$(date '+%H:%M:%S')" "$#" "$*" >> /tmp/claude-jump.log
target="$1"
[ -z "$target" ] && exit 2
# Full UUID → sid8
case "$target" in
  *-*-*-*-*) target="${target:0:8}" ;;
esac

# Path 1: delegate to a running monitor (sandbox-safe, no Apple Events here)
if pgrep -qf 'claude_monitor\.py'; then
  printf '%s' "$target" > /tmp/claude-jump-request
  printf '%s delegated=%s\n' "$(date '+%H:%M:%S')" "$target" >> /tmp/claude-jump.log
  exit 0
fi

# Path 2: direct JXA (normal shell, no monitor running)
result=$(osascript -l JavaScript -e '(() => {
    const target = "'"$target"'";
    const se = Application("System Events");
    try {
        const ghostty = Application("Ghostty");
        for (const w of ghostty.windows()) {
            for (const tab of w.tabs()) {
                const n = tab.name() || "";
                if (n.includes("·" + target) || (target.length > 8 && n.includes(target))) {
                    tab.selectTab();
                    ghostty.activateWindow(w);
                    delay(0.05);
                    try {
                        const proc = se.processes.byName("Ghostty");
                        proc.frontmost = true;
                        const aw = proc.windows.byName(w.name());
                        aw.actions["AXRaise"].perform();
                        try { aw.attributes["AXMain"].value = true; } catch(e) {}
                    } catch(e) {}
                    return "ok:" + n;
                }
            }
        }
        for (const w of ghostty.windows()) {
            for (const tab of w.tabs()) {
                const n = tab.name() || "";
                const bare = n.replace(/^[^\w]*\s*/, "").replace(/\s*·[0-9a-f]{8}$/, "").trim();
                if (bare === target) {
                    tab.selectTab();
                    ghostty.activateWindow(w);
                    return "ok:name:" + n;
                }
            }
        }
    } catch(e) { return "err:" + (e.errorNumber || "") + ":" + e.message; }
    return "not_found";
})()' 2>&1)
printf '%s result=%s\n' "$(date '+%H:%M:%S')" "$result" >> /tmp/claude-jump.log
case "$result" in ok*) exit 0 ;; *) exit 1 ;; esac
