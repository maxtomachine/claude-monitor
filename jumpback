#!/usr/bin/env bash
# jumpback — raise the claude-monitor window from anywhere
#
# Bind this to a key via:
#   Ghostty:  keybind = super+m=exec:~/Projects/claude-monitor/jumpback
#   skhd:     cmd - m : ~/Projects/claude-monitor/jumpback
#   Shortcuts.app: create a "Run Shell Script" shortcut, bind in System Settings

exec osascript -l JavaScript -e '(() => {
    const se = Application("System Events");

    // Ghostty: walk windows AND tabs via its scripting API. The monitor may be
    // a background tab — window.name() only shows the FRONT tab title.
    try {
        const ghostty = Application("Ghostty");
        for (const w of ghostty.windows()) {
            for (const tab of w.tabs()) {
                if ((tab.name() || "").includes("·MONITOR")) {
                    tab.selectTab();
                    ghostty.activateWindow(w);
                    delay(0.05);
                    try {
                        const proc = se.processes.byName("Ghostty");
                        proc.frontmost = true;
                        const aw = proc.windows.byName(w.name());
                        aw.actions["AXRaise"].perform();
                        try { aw.attributes["AXMain"].value = true; } catch(e) {}
                    } catch(e) {}
                    return "ok:tab";
                }
            }
        }
    } catch(e) {}

    // iTerm2/Terminal fallback: window-title scan (no tab API needed there)
    for (const appName of ["iTerm2", "Terminal"]) {
        let app, titles;
        try {
            app = Application(appName);
            titles = app.windows.name();
        } catch(e) { continue; }
        const match = titles.find(t => t && t.includes("·MONITOR"));
        if (!match) continue;
        app.activate();
        delay(0.1);
        const proc = se.processes.byName(appName);
        try {
            const w = proc.windows.byName(match);
            w.actions["AXRaise"].perform();
            try { w.attributes["AXMain"].value = true; } catch(e) {}
            return "ok:window";
        } catch(e) {}
        try {
            const menu = proc.menuBars[0].menuBarItems.byName("Window").menus[0];
            const item = menu.menuItems.name().find(n => n && n.includes("·MONITOR"));
            if (item) { menu.menuItems.byName(item).click(); return "ok:menu"; }
        } catch(e) {}
    }

    // No monitor anywhere — launch one
    try {
        const ghostty = Application("Ghostty");
        const w = ghostty.newWindow({
            withConfiguration: {command: "'"$HOME"'/.local/bin/claude-monitor"}
        });
        ghostty.activateWindow(w);
        return "launched";
    } catch(e) { return "not_found:" + e.message; }
})()'
